{
  "name": "pathology-manifest-collab",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-institution pathology manifest sharing service with identifier aliasing",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
